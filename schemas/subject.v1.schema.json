{
  "$id": "https://lernapps.net/apps/schemas/subject.v1.schema.json",
  "title": "lernapps.net learning map: subject",
  "description": "A subject of the learning map: map/<subject>.yaml",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "de": {
              "type": "string",
              "minLength": 1,
              "description": "German"
            },
            "en": {
              "description": "English",
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "de"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Name of the subject, e.g. Mathematik; the file name is its id"
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Title of the document, with its edition"
        },
        "url": {
          "description": "Where to read it, when it is online",
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "description": "Where the strands and competencies come from"
    },
    "strands": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Stable id, unique in the subject"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "de": {
                    "type": "string",
                    "minLength": 1,
                    "description": "German"
                  },
                  "en": {
                    "description": "English",
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "de"
                ],
                "additionalProperties": false
              }
            ]
          },
          "competencies": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                  "description": "Stable id, unique in the subject; never renamed once published"
                },
                "iCan": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "properties": {
                        "de": {
                          "type": "string",
                          "minLength": 1,
                          "description": "German"
                        },
                        "en": {
                          "description": "English",
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "de"
                      ],
                      "additionalProperties": false
                    }
                  ],
                  "description": "What a learner can do, in plain German: \"Ich kann …\""
                },
                "gradeBand": {
                  "type": "string",
                  "enum": [
                    "5-6",
                    "7-8",
                    "9-10"
                  ],
                  "description": "Roughly in which two school years it is taught; shown where no curriculum places it"
                },
                "requires": {
                  "description": "Competencies of the same subject a learner needs first, any strand",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  }
                }
              },
              "required": [
                "id",
                "iCan",
                "gradeBand"
              ],
              "additionalProperties": false,
              "description": "A competency (Baustein): one thing a learner can learn"
            }
          }
        },
        "required": [
          "id",
          "name",
          "competencies"
        ],
        "additionalProperties": false,
        "description": "A strand (Strang): a part of the subject that runs over several school years and builds on itself"
      }
    }
  },
  "required": [
    "name",
    "source",
    "strands"
  ],
  "additionalProperties": false
}
