{
  "$id": "https://lernapps.net/apps/schemas/curriculum.v1.schema.json",
  "title": "lernapps.net learning map: curriculum",
  "description": "A curriculum (Lehrplan) of one Land and school type for a subject: map/<subject>/curricula/<id>.yaml",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "land": {
      "type": "string",
      "enum": [
        "BW",
        "BY",
        "BE",
        "BB",
        "HB",
        "HH",
        "HE",
        "MV",
        "NI",
        "NW",
        "RP",
        "SL",
        "SN",
        "ST",
        "SH",
        "TH"
      ],
      "description": "The Land, ISO 3166-2:DE without DE-"
    },
    "schoolType": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "de": {
              "type": "string",
              "minLength": 1,
              "description": "German"
            },
            "en": {
              "description": "English",
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "de"
          ],
          "additionalProperties": false
        }
      ],
      "description": "The school type, e.g. Gymnasium (G9)"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Which document, which edition"
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Title of the document, with its edition"
        },
        "url": {
          "description": "Where to read it, when it is online",
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "description": "Where the strands and competencies come from"
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "competency": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "A competency of the subject"
          },
          "grades": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 13
            },
            "description": "The grades in which the curriculum places it"
          },
          "unit": {
            "description": "The curriculum's own name of the unit, e.g. 7.4",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "competency",
          "grades"
        ],
        "additionalProperties": false,
        "description": "A placement (Einordnung)"
      },
      "description": "May place only some competencies; at most one placement per competency"
    }
  },
  "required": [
    "land",
    "schoolType",
    "version",
    "source",
    "placements"
  ],
  "additionalProperties": false
}
