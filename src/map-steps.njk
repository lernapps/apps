---
pagination:
  data: map.stepsPages
  size: 1
  alias: view
permalink: "/{{ view.l.root }}map/{{ view.subject.id }}/c/index.html"
layout: base.njk
scripts: [map.js, map-steps.js]
eleventyComputed:
  title: "{{ t.map.steps.title(view.subject.name | tx(lang)) }}"
  description: "{{ t.map.steps.description(view.subject.name | tx(lang)) }}"
---
{#-
  The map of a subject by steps of the chain (feat/map-steps, issue #227): the same grid of strands (columns) as
  /map/<subject>/, but one row per step: a competency stands one row below its deepest prerequisite, the ones without
  prerequisite at the top (lib/map.js stepRows). It lives in c/, the tree of the competencies (KD-05).
  Without JS: every competency is a link to its page, which shows its chain. With JS (assets/map-steps.js): a click
  chooses a competency, shows its ancestors and descendants, draws the arrows of the chain and lists it step by step
  beside the map; assets/map.js does the legend as a filter and the help as a dialog, as on the subject page.
-#}
{%- set S = t.map.subject %}
{%- set P = t.map.steps %}
{%- set subject = view.subject %}
{%- set name = subject.name | tx(lang) %}
{%- import "components.njk" as c with context %}

<div class="max-w-7xl mx-auto px-4 sm:px-6 pt-6 pb-12 flex flex-col gap-4">
  {{ c.breadcrumb([
    { label: t.map.name, href: c.mapUrl('') | trim },
    { label: name, href: c.mapUrl(subject.id + '/') | trim, attrs: subject.name | fallbackLang(lang) },
    { label: S.order.steps }
  ]) }}

  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
    <h1 class="m-0 font-extrabold leading-tight tracking-tight text-slate-900" style="font-size: clamp(1.75rem, 5vw, 2.5rem);">{{ P.headline(name) }}</h1>
    <a href="#hilfe" class="map-help-link" data-opens="hilfe"><span aria-hidden="true" class="map-help-icon">?</span>{{ S.howTo.headline }}</a>
  </div>
  <p class="m-0 text-slate-700 max-w-3xl">{{ P.lead }}</p>

  {{ c.mapOrder(subject, 'steps') }}

  {%- set gapCount = subject.competencies.length - subject.covered %}
  <div class="map-toolbar">
    <div class="map-legend" data-map-legend>
      <p class="m-0 flex items-center gap-2 text-sm text-slate-600"><span aria-hidden="true" class="map-swatch map-chip-covered"></span>{{ S.legend.covered }}</p>
      <p class="m-0 flex items-center gap-2 text-sm text-slate-600"><span aria-hidden="true" class="map-swatch map-chip-gap"></span>{{ S.legend.gap }}</p>
    </div>
    <div class="map-legend" role="group" aria-label="{{ S.filter }}" data-map-filter hidden>
      <button type="button" class="map-filter" data-show="covered" aria-pressed="false"{% if not subject.covered %} disabled{% endif %}><span aria-hidden="true" class="map-swatch map-chip-covered"></span>{{ S.legend.covered }} <span class="map-filter-count">{{ subject.covered }}</span></button>
      <button type="button" class="map-filter" data-show="gap" aria-pressed="false"{% if not gapCount %} disabled{% endif %}><span aria-hidden="true" class="map-swatch map-chip-gap"></span>{{ S.legend.gap }} <span class="map-filter-count">{{ gapCount }}</span></button>
    </div>
  </div>

  <div class="map-bystep" data-map-steps>
    <div class="map-scroll" role="region" aria-label="{{ P.gridLabel(name) }}" tabindex="0">
      <table class="map-grid" style="min-width: {{ 7 + subject.strands.length * 12 }}rem;">
        <colgroup><col style="width: 7rem;">{% for s in subject.strands %}<col>{% endfor %}</colgroup>
        <thead>
          <tr>
            <td class="text-sm text-slate-600 align-bottom">{{ P.corner }}</td>
            {%- for s in subject.strands %}
            <th scope="col">
              <a href="{{ c.mapUrl(subject.id + '/' + s.id + '/') | trim }}" class="text-lg font-bold text-slate-900 underline underline-offset-2"{{ s.name | fallbackLang(lang) | safe }}>{{ s.name | tx(lang) }}</a>
              <span class="block mt-1 text-sm text-slate-600">{{ S.count(s.covered, s.total) }}</span>
              <span aria-hidden="true" class="map-bar mt-2"><span style="width: {{ (s.covered / s.total * 100) | round }}%;"></span></span>
            </th>
            {%- endfor %}
          </tr>
        </thead>
        <tbody>
          {%- for row in subject.stepRows %}
          <tr>
            <th scope="row">{{ P.row(row.step) }}<span class="block mt-1 text-xs font-normal text-slate-600">{{ P.rowCount(row.count) }}</span></th>
            {%- for cell in row.cells %}
            <td>
              {%- if cell.competencies.length %}
              <ul class="map-cell">
                {%- for id in cell.competencies %}
                {{ c.mapChip(subject, subject.competencies | byId(id), [], false) }}
                {%- endfor %}
              </ul>
              {%- endif %}
            </td>
            {%- endfor %}
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>

    {#- The chain of the chosen competency: shown and filled by assets/map-steps.js; without JS a competency's page
        shows its chain. #}
    <aside class="map-chain panel" aria-labelledby="kette-titel" data-map-chain hidden>
      <h2 id="kette-titel" class="m-0 text-sm font-semibold uppercase tracking-wide text-slate-600">{{ P.chain.headline }}</h2>
      <div aria-live="polite" data-chain-body><p class="m-0 text-slate-600">{{ P.chain.empty }}</p></div>
    </aside>
  </div>

  <p class="m-0 text-slate-600">{{ P.hint }}</p>

  <section id="hilfe" class="panel scroll-mt-4" aria-labelledby="hilfe-titel" data-kind="{{ name }}" data-map-help>
    <h2 id="hilfe-titel" class="m-0 text-xl font-bold text-slate-900" data-dialog-title>{{ S.howTo.headline }}</h2>
    <div class="mt-3" data-dialog-body>
      <dl class="m-0 grid gap-x-6 gap-y-3 sm:grid-cols-2">
        {%- for item in P.howTo %}
        <div><dt class="font-bold"><a href="{{ c.mapUrl('') | trim }}#{{ item.id }}" class="text-blue-700 underline underline-offset-2">{{ item.term }}</a> · {{ item.where }}</dt><dd class="m-0 mt-1 text-slate-600">{{ item.text }}</dd></div>
        {%- endfor %}
      </dl>
      <p class="m-0 mt-3"><a href="{{ c.mapUrl('') | trim }}#begriffe" class="text-blue-700 underline underline-offset-2">{{ S.howTo.all }}</a> · <a href="{{ c.mapUrl('') | trim }}#methode" class="text-blue-700 underline underline-offset-2">{{ S.howTo.method }}</a></p>
    </div>
  </section>
</div>

{#- What the script needs: the competencies with strand, requires, step and name, and its texts. #}
<script type="application/json" id="map-steps-data">{{ subject | stepsData(lang) | safe }}</script>
{%- set pageUrl = '' + (c.mapUrl(subject.id + '/c/{id}/') | trim) %}
{%- set texts = { kind: P.chain.kind("{strand}", "{step}"), step: P.row("{step}"), before: P.chain.before, after: P.chain.after, nothing: P.chain.nothing, page: P.chain.page, clear: P.chain.clear, pageUrl: pageUrl } %}
<script type="application/json" id="map-steps-text">{{ texts | dump | safe }}</script>
{{ c.mapDialog() }}
