---
pagination:
  data: map.termsPages
  size: 1
  alias: pageLanguage
permalink: "/{{ pageLanguage.root }}map/index.html"
layout: base.njk
scripts: [map.js]
eleventyComputed:
  title: "{{ t.map.terms.title }}"
  description: "{{ t.map.terms.description }}"
---
{#-
  The entry to the learning maps (feat/learning-map, B12): first the maps there are, then how they belong to the apps
  and why the map is a method of our own, last the terms (KD-02) as a picture of the model. Each box of the picture is
  a link to its definition in the list of terms; assets/map.js opens the definition as a dialog instead. The list is
  open without JavaScript; map.js closes it unless the address points into it. The arrows are drawn with CSS and hidden from screen readers, which read the same as sentences.
-#}
{%- set T = t.map.terms %}
{%- import "components.njk" as c with context %}

{%- macro node(id, cls="") %}{% set item = T.items | byId(id) %}<a href="#{{ id }}" class="map-node {{ cls }}" data-opens="{{ id }}"><b>{{ item.title }}</b><span>{{ T.nodes[id] }}</span></a>{% endmacro %}

<div class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 pb-12 flex flex-col gap-10">
  <div class="flex flex-col gap-3">
    <h1 class="m-0 font-extrabold leading-tight tracking-tight text-slate-900" style="font-size: clamp(1.75rem, 5vw, 2.5rem);">{{ T.headline }}</h1>
    <p class="m-0 max-w-3xl text-xl text-slate-700">{{ T.lead }}</p>
  </div>

  <section aria-labelledby="karten" class="flex flex-col gap-4">
    <h2 id="karten" class="m-0 text-2xl font-bold text-slate-900">{{ T.subjects }}</h2>
    <ul class="map-cards">
      {%- for s in map.subjects %}
      {%- set total = s.competencies.length %}
      {%- set filled = ((s.covered / total) * 32) | round if total else 0 %}
      {%- if s.covered and filled < 1 %}{% set filled = 1 %}{% endif %}
      <li>
        <a href="{{ c.mapUrl(s.id + '/') | trim }}" class="map-card">
          <b{{ s.name | fallbackLang(lang) | safe }}>{{ s.name | tx(lang) }}</b>
          <span class="map-mini" aria-hidden="true">{% for i in range(32) %}<i{% if i < filled %} class="map-mini-covered"{% endif %}></i>{% endfor %}</span>
          <span class="map-card-meta">{{ T.subjectInfo(s.strands.length, total) }}<br>{{ T.subjectCovered(s.covered) }}{% if s.curricula.length %} · {{ T.subjectCurricula(s.curricula.length) }}{% endif %}</span>
          <span class="map-card-go">{{ T.subjectOpen }} <span aria-hidden="true">→</span></span>
        </a>
      </li>
      {%- endfor %}
    </ul>
    <p class="m-0 text-slate-600">{{ T.subjectsMore }}</p>
  </section>

  <section aria-labelledby="apps" class="flex flex-col gap-4">
    <h2 id="apps" class="m-0 text-2xl font-bold text-slate-900">{{ T.apps.headline }}</h2>
    <ol class="map-steps">
      {%- for step in T.apps.steps %}<li>{{ step | safe }}</li>{% endfor %}
    </ol>
    <p class="m-0"><a href="{{ '/build/' | inLang(lang) | url }}" class="btn btn-secondary">{{ T.apps.build }}</a></p>
  </section>

  {%- set M = T.method %}
  <section aria-labelledby="methode" class="map-honest">
    <p class="map-honest-tag">{{ M.tag }}</p>
    <h2 id="methode" class="m-0 text-2xl font-bold text-slate-900">{{ M.headline }}</h2>
    <p>{{ M.intro }}</p>
    <ul>
      {%- for reason in M.reasons %}<li>{{ reason | safe }}</li>{% endfor %}
    </ul>
    <p>{{ M.ours }}</p>
    <p>{{ M.feedback }} <a href="{{ site.repo }}/issues/new?title={{ M.issueTitle | urlencode }}" class="text-blue-700 underline underline-offset-2">{{ M.feedbackLink }}</a> <span class="text-slate-600">{{ M.feedbackNote }}</span></p>
  </section>

  <hr class="map-rule">

  <section aria-labelledby="bild" class="flex flex-col gap-3">
    <h2 id="bild" class="m-0 text-2xl font-bold text-slate-900">{{ T.modelHeadline }}</h2>
    <p class="m-0 text-slate-600">{{ T.modelLead }}</p>
    <figure class="m-0 flex flex-col gap-3">
      <div class="map-scroll" role="region" aria-label="{{ T.pictureLabel }}" tabindex="0">
        <div class="map-model">
          <div class="map-loop" style="grid-column: 5; grid-row: 1;"><a href="#baut-auf" class="map-edge-link" data-opens="baut-auf">{{ T.edges.requires }}</a></div>
          <div style="grid-column: 1; grid-row: 2;" class="grid">{{ node("fach") }}</div>
          <div style="grid-column: 2; grid-row: 2;" class="map-edge map-edge-h" aria-hidden="true">{{ T.edges.hasMany }}</div>
          <div style="grid-column: 3; grid-row: 2;" class="grid">{{ node("strang") }}</div>
          <div style="grid-column: 4; grid-row: 2;" class="map-edge map-edge-h" aria-hidden="true">{{ T.edges.hasMany }}</div>
          <div style="grid-column: 5; grid-row: 2;" class="grid">{{ node("baustein", "map-node-main") }}</div>
          <div style="grid-column: 6; grid-row: 2;" class="map-edge map-edge-h" aria-hidden="true">{{ T.edges.placement }}</div>
          <div style="grid-column: 7; grid-row: 2;" class="grid">{{ node("lehrplan") }}</div>
          <div style="grid-column: 1; grid-row: 3;" class="map-edge map-edge-v map-edge-down" aria-hidden="true">{{ T.edges.from }}</div>
          <div style="grid-column: 3; grid-row: 3;" class="map-edge map-edge-v map-edge-up" aria-hidden="true">{{ T.edges.staysIn }}</div>
          <div style="grid-column: 5; grid-row: 3;" class="map-edge map-edge-v map-edge-up map-edge-blue" aria-hidden="true">{{ T.edges.practises }}</div>
          <div style="grid-column: 1; grid-row: 4;" class="grid">{{ node("quelle", "map-node-source") }}</div>
          <div style="grid-column: 3; grid-row: 4;" class="grid">{{ node("app", "map-node-app") }}</div>
          <div style="grid-column: 4; grid-row: 4;" class="map-edge map-edge-h" aria-hidden="true">{{ T.edges.hasMany }}</div>
          <div style="grid-column: 5; grid-row: 4;" class="grid">{{ node("seite", "map-node-app") }}</div>
        </div>
      </div>
      <figcaption class="text-slate-600">
        <p class="m-0">{{ T.sentencesLead }}</p>
        <ul class="m-0 mt-1 pl-5 grid gap-x-6 sm:grid-cols-2">
          {%- for sentence in T.sentences %}<li>{{ sentence }}</li>{% endfor %}
        </ul>
      </figcaption>
    </figure>
  </section>

  <details class="map-terms" open data-map-terms>
    <summary><h2 id="begriffe" class="m-0 text-xl font-bold text-slate-900">{{ T.definitions }}</h2></summary>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      {%- for item in T.items %}
      <article id="{{ item.id }}" class="panel scroll-mt-4" data-kind="{{ T.kind }}" aria-labelledby="{{ item.id }}-titel">
        <h3 id="{{ item.id }}-titel" class="m-0 text-xl font-bold text-slate-900" data-dialog-title>{{ item.title }}</h3>
        <div class="mt-2 flex flex-col gap-3" data-dialog-body>
          <p class="m-0">{{ item.text }}</p>
          <p class="m-0 p-3 rounded-lg bg-slate-100 text-slate-800"><b>{{ T.example }}</b> {{ item.example }}</p>
          <p class="m-0 text-slate-600"><b class="text-slate-800">{{ T.inPicture }}</b> {{ item.links }}</p>
        </div>
      </article>
      {%- endfor %}
    </div>
  </details>

  <section aria-labelledby="regeln">
    <h2 id="regeln" class="m-0 text-2xl font-bold text-slate-900">{{ T.rulesHeadline }}</h2>
    <ol class="m-0 mt-3 pl-6 flex flex-col gap-2 text-lg">
      {%- for rule in T.rules %}<li>{{ rule }}</li>{% endfor %}
    </ol>
  </section>

  <p class="m-0 text-sm text-slate-600">{{ T.data }}
    {%- for s in map.subjects %} <a href="{{ ('/map/' + s.id + '.json') | url }}" class="text-blue-700 underline underline-offset-2">{{ s.id }}.json</a>{% if not loop.last %},{% endif %}{% endfor %}</p>
</div>

{{ c.mapDialog() }}
