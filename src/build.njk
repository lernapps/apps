---
permalink: /build/index.html
layout: base.njk
scripts: [kopieren.js]
eleventyComputed:
  title: "{{ de.build.title }}"
  description: "{{ de.build.description }}"
---
{#-
  Bauen: the creator's entry point to building an app with the tooling of lernapps.net (site.tooling): the prompt
  to give the assistant, the command that starts the app, the skill as the quick path, then on to listing (/enter/).
  test/entry-point.e2e.test.mjs runs the command from the built page.
-#}
{%- set B = de.build %}
{%- import "components.njk" as c with context %}
<section class="bg-slate-900 text-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-10 pb-12">
    <h1 class="m-0 font-extrabold leading-tight tracking-tight whitespace-pre-line" style="font-size: clamp(1.75rem, 5vw, 2.75rem);">{{ B.headline }}</h1>
    <p class="m-0 mt-3 text-lg text-slate-300 max-w-2xl">{{ B.lead }}</p>
  </div>
</section>

<div class="max-w-4xl mx-auto px-4 sm:px-6 mt-8 grid gap-6">
  <section class="panel min-w-0" aria-labelledby="start">
    <h2 id="start" class="panel-title">{{ B.start.headline }}</h2>
    <p class="m-0 text-slate-700">{{ B.start.body }}</p>
    <div class="mt-3">
      {{ c.copyField("bauen-auftrag", B.start.label, B.start.prompt(site.tooling.llms, site.tooling.create), B.start.copy, B.start.copied, true) }}
    </div>
    <p class="m-0 mt-3 text-slate-700">{{ B.start.command }}</p>
    <pre class="m-0 mt-1 p-3 rounded bg-slate-100 text-sm overflow-x-auto"><code>{{ site.tooling.create }}</code></pre>
    <p class="m-0 mt-3 text-slate-700">{{ B.start.skill }} <a href="{{ site.tooling.skill }}" class="text-blue-700 underline underline-offset-2">lernapps-app</a>.</p>
  </section>

  <section class="panel" aria-labelledby="weiter">
    <h2 id="weiter" class="panel-title">{{ B.next.headline }}</h2>
    <p class="m-0 text-slate-700">{{ B.next.body }}</p>
    <p class="m-0 mt-3 text-slate-700">{{ B.next.criteria }} <a href="{{ '/enter/#bedingungen' | url }}" class="text-blue-700 underline underline-offset-2">{{ B.next.criteriaLink }}</a>.</p>
    <p class="m-0 mt-3 text-slate-700">{{ B.next.enter }}</p>
    <a href="{{ '/enter/' | url }}" class="btn btn-primary mt-4 self-start">{{ B.next.enterLink }}</a>
  </section>
</div>
