---
pagination:
  data: languages
  size: 1
  alias: pageLanguage
permalink: "/{{ pageLanguage.root }}build/index.html"
layout: base.njk
scripts: [kopieren.js]
eleventyComputed:
  title: "{{ t.build.title }}"
  description: "{{ t.build.description }}"
---
{#-
  Bauen: the creator's entry point to building an app with the tooling of lernapps.net (site.tooling): the prompt
  to give the assistant, the command that starts the app, the skill as the quick path, building freely without the
  templates (any framework, or tools such as Lovable or bolt.new), then on to listing (/enter/), the section #eintragen, which the header's "App bauen" now stands for too.
  test/entry-point.e2e.test.mjs runs the command from the built page.
-#}
{%- set B = t.build %}
{%- import "components.njk" as c with context %}
<section class="bg-slate-900 text-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-10 pb-12">
    <h1 class="m-0 font-extrabold leading-tight tracking-tight whitespace-pre-line" style="font-size: clamp(1.75rem, 5vw, 2.75rem);">{{ B.headline }}</h1>
    <p class="m-0 mt-3 text-lg text-slate-300 max-w-2xl">{{ B.lead }}</p>
    <p class="m-0 mt-4 text-slate-300">{{ B.haveApp }} <a href="#eintragen" class="text-blue-300 underline underline-offset-2 hover:text-white">{{ B.haveAppLink }} ↓</a></p>
  </div>
</section>

<div class="max-w-4xl mx-auto px-4 sm:px-6 mt-8 grid gap-6">
  <section class="panel min-w-0" aria-labelledby="start">
    <h2 id="start" class="panel-title">{{ B.start.headline }}</h2>
    <p class="m-0 text-slate-700">{{ B.start.body }}</p>
    <div class="mt-3">
      {{ c.copyField("bauen-auftrag", B.start.label, B.start.prompt(site.tooling.llms, site.tooling.create), B.start.copy, B.start.copied, true) }}
    </div>
    <p class="m-0 mt-3 text-slate-700">{{ B.start.command }}</p>
    <pre class="m-0 mt-1 p-3 rounded bg-slate-100 text-sm overflow-x-auto"><code>{{ site.tooling.create }}</code></pre>
    <p class="m-0 mt-3 text-slate-700">{{ B.start.skill }} <a href="{{ site.tooling.skill }}" class="text-blue-700 underline underline-offset-2">lernapps-app</a>.</p>
  </section>

  <section class="panel" aria-labelledby="werkzeuge">
    <h2 id="werkzeuge" class="panel-title">{{ B.tools.headline }}</h2>
    <p class="m-0 text-slate-700">{{ B.tools.body }}</p>
    <p class="m-0 mt-3 text-slate-700">{{ B.tools.github }} <a href="{{ site.tooling.github | otherSiteIn(pageLanguage.code) }}" class="text-blue-700 underline underline-offset-2"{% if B.tools.linkLang %} hreflang="{{ B.tools.linkLang }}"{% endif %}>{{ B.tools.githubLink }}</a>.</p>
    <a href="{{ site.tooling.home | otherSiteIn(pageLanguage.code) }}" class="btn btn-secondary mt-4 self-start"{% if B.tools.linkLang %} hreflang="{{ B.tools.linkLang }}" lang="{{ B.tools.linkLang }}"{% endif %}>{{ B.tools.link }}</a>
  </section>

  <section class="panel" aria-labelledby="frei">
    <h2 id="frei" class="panel-title">{{ B.free.headline }}</h2>
    <p class="m-0 text-slate-700">{{ B.free.body }} <a href="{{ site.tooling.platformRules }}" class="text-blue-700 underline underline-offset-2"{% if B.free.rulesLang %} hreflang="{{ B.free.rulesLang }}"{% endif %}>{{ B.free.rulesLink }}</a> {{ B.free.rules }} <a href="{{ '/enter/#bedingungen' | inLang(lang) | url }}" class="text-blue-700 underline underline-offset-2">{{ B.free.criteriaLink }}</a>. {{ B.free.check }}</p>
  </section>

  <section class="panel scroll-mt-16" aria-labelledby="eintragen">
    <h2 id="eintragen" class="panel-title">{{ B.next.headline }}</h2>
    <p class="m-0 text-slate-700">{{ B.next.body }}</p>
    <p class="m-0 mt-3 text-slate-700">{{ B.next.criteria }} <a href="{{ '/enter/#bedingungen' | inLang(lang) | url }}" class="text-blue-700 underline underline-offset-2">{{ B.next.criteriaLink }}</a>.</p>
    <p class="m-0 mt-3 text-slate-700">{{ B.next.enter }}</p>
    <a href="{{ '/enter/' | inLang(lang) | url }}" class="btn btn-primary mt-4 self-start">{{ B.next.enterLink }}</a>
  </section>
</div>
