---
pagination:
  data: map.competencyPages
  size: 1
  alias: view
permalink: "/{{ view.l.root }}map/{{ view.subject.id }}/c/{{ view.competency.id }}/index.html"
layout: base.njk
eleventyComputed:
  title: "{{ t.map.competency.title(view.competency.name | tx(lang), view.subject.name | tx(lang)) }}"
  description: "{{ view.competency.iCan | tx(lang) }}"
---
{#-
  A competency (feat/learning-map, B10): "Ich kann …", strand; the apps and pages that practise it, or that it is a gap, first; then its chain
  (feat/map-steps, by grade and step since feat/map-chains KD-17: every ancestor and the direct descendants by step, also across strands);
  when each captured curriculum places it ("Wann ist er dran?") and the source, both folded away.
-#}
{%- set K = t.map.competency %}
{%- set subject = view.subject %}
{%- set comp = view.competency %}
{%- set strand = subject.strands | byId(comp.strand) %}
{%- set label = comp.name | tx(lang) %}
{%- import "components.njk" as c with context %}

<div class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 pb-12 flex flex-col gap-8">
  {{ c.breadcrumb([
    { label: t.map.name, href: c.mapUrl('') | trim },
    { label: subject.name | tx(lang), href: c.mapUrl(subject.id + '/') | trim, attrs: subject.name | fallbackLang(lang) },
    { label: strand.name | tx(lang), href: c.mapUrl(subject.id + '/' + strand.id + '/') | trim, attrs: strand.name | fallbackLang(lang) },
    { label: label, attrs: comp.name | fallbackLang(lang) }
  ]) }}

  <div class="flex flex-col gap-3 items-start">
    <a href="{{ c.mapUrl('') | trim }}#baustein" class="text-sm text-blue-700 underline underline-offset-2">{{ K.whatIs }}</a>
    <h1 class="m-0 font-extrabold leading-tight tracking-tight text-slate-900" style="font-size: clamp(1.5rem, 4.5vw, 2.25rem);"{{ comp.name | fallbackLang(lang) | safe }}>{{ label }}</h1>
    <p class="m-0 text-lg text-slate-700"{{ comp.iCan | fallbackLang(lang) | safe }}>{{ K.quote(comp.iCan | tx(lang)) }}</p>
    <dl class="map-facts w-full mt-2">
      <div><dt>{{ K.strand }}</dt><dd><a href="{{ c.mapUrl(subject.id + '/' + strand.id + '/') | trim }}" class="text-blue-700 underline underline-offset-2"{{ strand.name | fallbackLang(lang) | safe }}>{{ strand.name | tx(lang) }}</a></dd></div>
      <div><dt>{{ K.richtstufe }}</dt><dd>{{ comp.gradeBand | bandLabel(subject, lang) }}</dd></div>
    </dl>
  </div>

  {#- The apps come first (feat/app-first-competency): which app practises it is what a visitor looks for; the placement follows. #}
  <section aria-labelledby="wer" class="flex flex-col gap-3">
    {%- set A = K.apps %}
    <h2 id="wer" class="m-0 text-xl font-bold text-slate-900">{{ A.headline }}</h2>
    {%- if comp.practisedBy.length %}
    <ul class="list-none p-0 m-0 flex flex-col gap-3">
      {%- for p in comp.practisedBy %}
      <li class="panel panel-main min-w-0 flex flex-wrap items-center justify-between gap-4">
        <div class="min-w-0 flex-[1_1_18rem]">
          <h3 class="m-0 text-2xl font-extrabold leading-tight text-slate-900"{{ p.app.title | fallbackLang(lang) | safe }}>{{ p.app.title | tx(lang) }}</h3>
          <p class="m-0 mt-1 text-slate-600">{{ p.app.grades | gradeLabel(lang) }}</p>
          {%- if p.pages.length %}
          <p class="m-0 mt-3 text-sm text-slate-700">{{ A.pages }}</p>
          <ul class="list-none p-0 m-0 mt-1 flex flex-wrap gap-x-4 gap-y-1">
            {%- for page in p.pages %}<li><a href="{{ page.url }}" class="text-blue-700 underline underline-offset-2"{{ page.title | fallbackLang(lang) | safe }}>{{ page.title | tx(lang) }}</a></li>{% endfor %}
          </ul>
          {%- endif %}
        </div>
        <a href="{{ ('/' + p.app.id + '/') | inLang(lang) | url }}" class="btn btn-primary btn-lg">{{ A.appLink }} <span aria-hidden="true">→</span></a>
      </li>
      {%- endfor %}
    </ul>
    {%- else %}
    <p class="m-0 p-4 rounded-lg map-chip-gap">{{ A["none"] }}</p>
    {%- endif %}
    <p class="m-0 text-slate-700">{{ A.build }} <a href="{{ '/build/' | inLang(lang) | url }}" class="text-blue-700 underline underline-offset-2">{{ A.buildLink }}</a></p>
  </section>

  {#- The chain (feat/map-steps, KD-06, KD-09): every ancestor by step, the direct ones marked; the direct descendants
      by step, and how many more build on it, with a link to the map by steps. #}
  {%- set P = K.path %}
  <section class="panel" aria-labelledby="weg">
    <h2 id="weg" class="panel-title">{{ P.headline }}</h2>
    <p class="m-0 text-slate-600">{{ P.lead }}</p>
    <div class="grid gap-4 md:grid-cols-[1fr_auto_1fr_auto_1fr] items-start mt-3">
      <div>
        <h3 class="m-0 text-sm font-semibold text-slate-600">{{ P.requires }}{% if comp.ancestorCount %} · {{ comp.ancestorCount }}{% endif %}</h3>
        {%- if comp.ancestorsByStep.length %}
        <dl class="map-chain-steps">
          {%- for group in comp.ancestorsByStep %}
          <dt>{{ group.band | placeLabel(group.bandStep, subject, lang) }}</dt>
          <dd><ul>{% for id in group.ids %}<li>{{ c.mapCompetencyLink(subject, id, comp.strand) }}{% if id in comp.requires %} <span class="map-direct">{{ P.direct }}</span>{% endif %}</li>{% endfor %}</ul></dd>
          {%- endfor %}
        </dl>
        {%- else %}<p class="m-0 mt-2 text-slate-600">{{ P.requiresNone }}</p>{% endif %}
      </div>
      <span aria-hidden="true" class="hidden md:block text-2xl text-slate-500">→</span>
      <div class="p-3 rounded-lg bg-blue-700 text-white">
        <h3 class="m-0 text-sm font-semibold">{{ P.self }} · {{ comp.gradeBand | placeLabel(comp.place.step, subject, lang) }}</h3>
        <p class="m-0 mt-1 font-bold"{{ comp.name | fallbackLang(lang) | safe }}>{{ label }}</p>
      </div>
      <span aria-hidden="true" class="hidden md:block text-2xl text-slate-500">→</span>
      <div>
        <h3 class="m-0 text-sm font-semibold text-slate-600">{{ P.requiredBy }}</h3>
        {%- if comp.childrenByStep.length %}
        <dl class="map-chain-steps">
          {%- for group in comp.childrenByStep %}
          <dt>{{ group.band | placeLabel(group.bandStep, subject, lang) }}</dt>
          <dd><ul>{% for id in group.ids %}<li>{{ c.mapCompetencyLink(subject, id, comp.strand) }}</li>{% endfor %}</ul></dd>
          {%- endfor %}
        </dl>
        {%- if comp.furtherCount %}
        <p class="m-0 mt-3 text-slate-700">{{ P.further(comp.furtherCount, comp.furtherSteps) }}</p>
        {%- endif %}
        {%- else %}<p class="m-0 mt-2 text-slate-600">{{ P.requiredByNone }}</p>{% endif %}
      </div>
    </div>
    <p class="m-0 mt-4"><a href="{{ c.mapUrl(subject.id + '/c/') | trim }}#{{ comp.id }}" class="text-blue-700 underline underline-offset-2">{{ P.furtherLink }}</a></p>
    {%- if subject.vocabulary and comp.strand == "wortschatz" %}
    <p class="m-0 mt-3 text-slate-700">{{ t.map.vocabulary.linkLead }} <a href="{{ c.mapUrl(subject.id + '/grundwortschatz/') | trim }}" class="text-blue-700 underline underline-offset-2">{{ t.map.vocabulary.link }} {{ subject.name | tx(lang) }}</a></p>
    {%- endif %}
  </section>

  <details class="panel">
    {%- set W = K.when %}
    <summary class="cursor-pointer"><h2 id="wann" class="inline m-0 text-xl font-bold text-slate-900">{{ W.headline }}</h2></summary>
    <p class="m-0 mt-3 text-slate-600">{{ W.body }}</p>
    <div class="map-scroll mt-3" role="region" aria-labelledby="wann" tabindex="0">
      <table class="map-table">
        <thead>
          <tr><th scope="col" style="width: 40%;">{{ W.head.which }}</th><th scope="col">{{ W.head.grade }}</th><th scope="col">{{ W.head.unit }}</th><th scope="col">{{ W.head.state }}</th></tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">{{ W.richtstufe }}</th>
            <td><strong>{{ comp.gradeBand | bandShort(subject, lang) }}</strong></td>
            <td class="text-slate-600">{{ W.standard }}</td>
            <td>{{ W.catalog }}</td>
          </tr>
          {%- for cu in subject.curricula %}
          {%- set placed = cu.placements[comp.id] %}
          <tr>
            <th scope="row" class="font-normal"><a href="{{ c.mapUrl(subject.id + '/' + cu.id + '/') | trim }}" class="text-blue-700 underline underline-offset-2">{{ t.map.lands[cu.land] }}, {{ cu.schoolType | tx(lang) }}</a></th>
            {%- if placed %}
            <td>{{ placed.grades | join(", ") }}</td>
            <td>{% if placed.unit %}{{ W.unit(placed.unit) }}{% else %}–{% endif %}</td>
            {%- else %}
            <td>–</td>
            <td class="text-slate-600">{{ W.unplaced }}</td>
            {%- endif %}
            <td>{{ W.captured }}</td>
          </tr>
          {%- endfor %}
          {%- set missing = [] %}
          {%- for l in subject.lands %}{% if not l.curricula.length %}{% set _ = missing.push(t.map.lands[l.land]) %}{% endif %}{% endfor %}
          {%- if missing.length %}
          <tr>
            <th scope="row" class="font-normal">{{ W.others }} ({{ missing.length }})</th>
            <td class="text-slate-600">–</td>
            <td class="text-slate-600">–</td>
            <td class="text-slate-600">{{ W.missing }}</td>
          </tr>
          {%- endif %}
        </tbody>
      </table>
    </div>
    {%- if missing.length %}
    <p class="m-0 mt-3 text-sm text-slate-600">{{ W.others }}, {{ W.missing }}: {{ missing | join(", ") }}</p>
    {%- endif %}
  </details>

  <details class="panel">
    <summary class="cursor-pointer"><h2 id="quelle" class="inline m-0 text-xl font-bold text-slate-900">{{ K.source }}</h2></summary>
    <p class="m-0 mt-3" lang="de">{% if subject.source.url %}<a href="{{ subject.source.url }}" class="text-blue-700 underline underline-offset-2">{{ subject.source.title }}</a>{% else %}{{ subject.source.title }}{% endif %}</p>
  </details>
</div>
