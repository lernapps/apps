---
pagination:
  data: languages
  size: 1
  alias: pageLanguage
permalink: "/{{ pageLanguage.root }}enter/index.html"
layout: base.njk
scripts: [kopieren.js]
eleventyComputed:
  title: "{{ t.list.title }}"
  description: "{{ t.list.description }}"
---
{#-
  Eintragen: steps s-listing-help and t-list-app of x-list-and-hear-back (D7), channel ch-listing (D5):
  a few fields, an automatic check (src/_data/catalog.js). The way is the creator's AI assistant with the skill
  lernapps-listing (site.tooling.listing, which follows llms.txt); the issue form for those without one; the owner's
  personal help by e-mail (concierge, D8 mvp-first-draft) only as the fallback, the one mailto of the page.
  Building an app comes first, on its own page (/build/, build.njk); this page lists an app that is published.
  "So läuft das Eintragen ab" shows the listing as steps, coloured by who acts (KD-21: the copy, linked with the repo).
  "Was du zurückbekommst" is s-use-insight: thanks and feedback, counted openly, on the app's page.
-#}
{%- set L = t.list %}
{%- import "components.njk" as c with context %}
<section class="bg-slate-900 text-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-10 pb-12">
    <h1 class="m-0 font-extrabold leading-tight tracking-tight whitespace-pre-line" style="font-size: clamp(1.75rem, 5vw, 2.75rem);">{{ L.headline }}</h1>
    <p class="m-0 mt-3 text-lg text-slate-300 max-w-2xl">{{ L.lead }}</p>
    <p class="m-0 mt-3 text-slate-300">{{ L.noApp }} <a href="{{ '/build/' | inLang(lang) | url }}" class="text-white underline underline-offset-2">{{ L.noAppLink }}</a></p>
  </div>
</section>

<div class="max-w-4xl mx-auto px-4 sm:px-6 mt-8 grid gap-6">
  <section class="panel" id="bedingungen" aria-labelledby="bedingungen-titel">
    <h2 id="bedingungen-titel" class="panel-title">{{ L.criteria.headline }}</h2>
    <ul class="list-none p-0 m-0 flex flex-col gap-2">
      {%- for item in L.criteria.items %}<li class="check">{{ item }}</li>{% endfor %}
    </ul>
  </section>

  <section class="panel" aria-labelledby="angaben">
    <h2 id="angaben" class="panel-title">{{ L.fields.headline }}</h2>
    <ol class="m-0 pl-5 list-decimal flex flex-col gap-2">
      {%- for f in L.fields.items %}<li><strong>{{ f.label }}</strong> {{ f.hint }}</li>{% endfor %}
    </ol>
    <p class="m-0 mt-3 text-slate-600">{{ L.fields.optional }}</p>
  </section>

  <section class="panel" aria-labelledby="ablauf">
    <h2 id="ablauf" class="panel-title">{{ L.flow.headline }}</h2>
    <ol class="flow">
      {%- for s in L.flow.steps %}
      <li class="flow-step" data-who="{{ s.who }}">
        <span class="flow-who">{{ s.label }}</span>
        <h3 class="m-0 mt-1 text-base font-bold text-slate-900">{{ s.title }}</h3>
        <p class="m-0 mt-1 text-sm text-slate-700">{{ s.body }}</p>
      </li>
      {%- endfor %}
    </ol>
    <p class="m-0 mt-4 text-slate-700">{{ L.flow.after }} <a href="{{ '/build/#veroeffentlichen' | inLang(lang) | url }}" class="text-blue-700 underline underline-offset-2">{{ L.flow.afterLink }}</a>.</p>
  </section>

  <section aria-labelledby="wege">
    <h2 id="wege" class="m-0 text-xl font-bold text-slate-900">{{ L.ways.headline }}</h2>
    <div class="panel panel-main mt-3 min-w-0">
      <h3 class="m-0 text-lg font-bold">{{ L.ways.agent.title }}</h3>
      <p class="m-0 mt-2 text-slate-700">{{ L.ways.agent.body }}</p>
      <div class="mt-3">
        {{ c.copyField("auftrag", L.ways.agent.label, L.ways.agent.prompt(site.tooling.listingRaw, site.tooling.skills), L.ways.agent.copy, L.ways.agent.copied, true) }}
      </div>
      <p class="m-0 mt-3 text-slate-700">{{ L.ways.agent.skill }} <a href="{{ site.tooling.listing }}" class="text-blue-700 underline underline-offset-2">lernapps-listing</a>.</p>
    </div>
    <div class="panel mt-4 flex flex-col">
      <h3 class="m-0 text-base font-bold">{{ L.ways.form.title }}</h3>
      <p class="m-0 mt-2 text-slate-700">{{ L.ways.form.body }}</p>
      <a href="{{ site.repo }}/issues/new?template=app-enter.yml" class="btn btn-secondary mt-3 self-start">{{ L.ways.form.button }}</a>
    </div>
  </section>

  <section id="notfalls" aria-labelledby="notfalls-titel" class="text-slate-600">
    <h2 id="notfalls-titel" class="m-0 text-base font-semibold">{{ L.ways.mail.title }}</h2>
    <p class="m-0 mt-1">{{ L.ways.mail.before }} <a href="mailto:{{ site.email }}?subject={{ L.ways.mail.subject | urlencode }}" class="underline underline-offset-2">{{ L.ways.mail.link }}</a>. {{ L.ways.mail.after }}</p>
  </section>

  <section class="panel" aria-labelledby="zurueck">
    <h2 id="zurueck" class="panel-title">{{ L.back.headline }}</h2>
    <p class="m-0 text-slate-700">{{ L.back.body }}</p>
  </section>
</div>
