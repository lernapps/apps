{
  "name": "lernapps-apps",
  "private": true,
  "type": "module",
  "description": "Find learning apps for your class or your child: lernapps.net/apps/",
  "scripts": {
    "dev": "npm run build && (eleventy --serve --quiet & unocss \"_site/**/*.html\" --out-file _site/uno.css --watch; wait)",
    "build": "rm -rf _site && eleventy && unocss \"_site/**/*.html\" --out-file _site/uno.css --minify",
    "schema": "node scripts/schema.mjs",
    "check": "node scripts/schema.mjs --check && lernapps-check --site /apps/",
    "listing": "node scripts/listing.mjs",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@lernapps/site": "github:lernapps/lernapps.github.io#f2b3a5dcef39e087b329f030aec7b011e9a5d902",
    "@lernapps/tooling": "github:lernapps/tooling#88d8290b3f198919a89673db1225c01c89aa380b",
    "@unocss/cli": "66.12.0",
    "@unocss/preset-typography": "66.12.0",
    "@unocss/preset-wind4": "66.12.0",
    "js-yaml": "5.5.0",
    "nunjucks": "3.2.4",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  }
}
