{
  "name": "lernapps-apps",
  "private": true,
  "type": "module",
  "description": "Find learning apps for your class or your child: lernapps.net/apps/",
  "scripts": {
    "dev": "npm run build && (eleventy --serve --quiet & unocss \"_site/**/*.html\" --out-file _site/uno.css --watch; wait)",
    "build": "rm -rf _site && eleventy && unocss \"_site/**/*.html\" --out-file _site/uno.css --minify",
    "schema": "node scripts/schema.mjs",
    "check": "node scripts/schema.mjs --check && lernapps-check --site /apps/",
    "listing": "node scripts/listing.mjs",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.mjs\""
  },
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@lernapps/site": "github:lernapps/lernapps.github.io#bd3ca7cd112220714f6a0db56d098253f913c4cc",
    "@lernapps/tooling": "github:lernapps/tooling#1e12712bfa18a7f116307d8841d8cff5b0f008ed",
    "@unocss/cli": "66.10.5",
    "@unocss/preset-typography": "66.10.5",
    "@unocss/preset-wind4": "66.10.5",
    "js-yaml": "5.4.3",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  }
}
