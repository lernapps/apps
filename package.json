{
  "name": "lernapps-apps",
  "private": true,
  "type": "module",
  "description": "Find learning apps for your class or your child: lernapps.net/apps/",
  "scripts": {
    "dev": "npm run build && (eleventy --serve --quiet & unocss \"_site/**/*.html\" --out-file _site/uno.css --watch; wait)",
    "build": "rm -rf _site && eleventy && unocss \"_site/**/*.html\" --out-file _site/uno.css --minify",
    "schema": "node scripts/schema.mjs",
    "check": "node scripts/schema.mjs --check && lernapps-check --site /apps/",
    "listing": "node scripts/listing.mjs",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@lernapps/site": "github:lernapps/lernapps.github.io#f462934d18af602b7330fb096ce4537d5202fe2e",
    "@lernapps/tooling": "github:lernapps/tooling#1618e1200db04b39fd4493fc4ed8d55d55a1ef76",
    "@unocss/cli": "66.11.0",
    "@unocss/preset-typography": "66.11.0",
    "@unocss/preset-wind4": "66.11.0",
    "js-yaml": "5.4.3",
    "nunjucks": "3.2.4",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  }
}
